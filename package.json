{
	"name": "tslider",
	"author": "Crystyan Verly",
	"homepage": "https://tslider.vercel.app",
	"version": "0.1.2",
	"description": "Dependency-free slider/carousel in vanilla TypeScript",
	"type": "module",
	"main": "./dist/tslider.cjs",
	"module": "./dist/tslider.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/tslider.js",
			"require": "./dist/tslider.cjs"
		},
		"./style.css": "./dist/style.css"
	},
	"files": [
		"dist"
	],
	"sideEffects": [
		"**/*.css"
	],
	"license": "MIT",
	"keywords": [
		"slider",
		"carousel",
		"typescript",
		"vanilla"
	],
	"repository": "github:CrystyanVerly/tslider",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"build:lib": "vite build --config vite.lib.config.ts",
		"prepublishOnly": "npm run build:lib"
	},
	"devDependencies": {
		"typescript": "~6.0.2",
		"vite": "^8.3.0",
		"vite-plugin-dts": "^5.1.0"
	}
}
